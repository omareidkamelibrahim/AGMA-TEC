generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  service   String?
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ---------- Admin dashboard (HR suite) ----------

model Employee {
  id         String    @id @default(cuid())
  empCode    String    @unique
  name       String
  department String
  position   String
  status     String // Active | Probation | Suspended | Terminated
  hireDate   DateTime
  manager    String?
  idNumber   String? // ID / Iqama number
  idExpiry   DateTime? // ID / Iqama expiry
  email      String?
  phone      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LeaveRequest {
  id           String   @id @default(cuid())
  employeeName String
  empCode      String
  department   String
  type         String // Annual | Sick | Unpaid | Emergency
  fromDate     DateTime
  toDate       DateTime
  days         Int
  status       String // Pending | Approved | Rejected
  reason       String?
  createdAt    DateTime @default(now())
}

model PayrollRun {
  id         String   @id @default(cuid())
  reference  String   @unique
  period     String // e.g. 2026-01
  employees  Int
  gross      Float
  deductions Float
  net        Float
  status     String // Draft | Processed | Paid
  createdAt  DateTime @default(now())
}

model NumberingSeries {
  id        String   @id @default(cuid())
  document  String // e.g. HR_PAYROLL_RUN - Payroll run
  prefix    String // e.g. PR-
  padding   Int      @default(5)
  dateToken String?
  scope     String?
  createdAt DateTime @default(now())
}
